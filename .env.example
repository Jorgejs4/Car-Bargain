# Servicios
DATABASE_URL=postgresql+psycopg://carbargains:carbargains@localhost:5432/carbargains
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=carbargains
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=carbargains
APP_DOMAIN=app.example.com
INSTALL_CV=false

# Aplicación
SECRET_KEY=change-me
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Clave compartida de los endpoints internos POST /internal/* (no públicos)
INTERNAL_API_KEY=change-me-internal

# Cloudflare R2 (free tier) — para raw data
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Scraping
SCRAPER_PROXY=
# Scheduler: celery (Oracle/servidor 24x7) o github (Actions dispara la API)
SCRAPER_SCHEDULER=celery

# Umbrales de status (horas), configurables por fuente
STATUS_STALE_AFTER_HOURS=6
STATUS_REMOVED_AFTER_HOURS=48
# Sobrescribe los umbrales globales por fuente (JSON)
# STATUS_THRESHOLDS_JSON={"mobile_de": {"stale_after_hours": 6, "removed_after_hours": 48}}

# Lock Redis anti-solapamiento del scraper (segundos)
SCRAPER_LOCK_TTL_SECONDS=840

# Alertas por email (SMTP gratuito; dejar SMTP_HOST vacío para desactivar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
ALERT_EMAIL_TO=

# URL pública de la API usada por Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Detección de daños visuales (CV, Fase 3)
CV_ENABLED=true
CV_MODEL_NAME=ViT-B-32
CV_PRETRAINED=laion400m_e32
# Probabilidad mínima para considerar daño visible en una foto
DAMAGE_PROB_MIN=0.65
# Penalización de riesgo cuando el texto dice "sin accidentes" pero la foto muestra daño
CONTRADICTION_TOLERANCE=0.3
