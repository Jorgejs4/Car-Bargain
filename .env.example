# Servicios
DATABASE_URL=postgresql+psycopg://carbargains:carbargains@localhost:5432/carbargains
REDIS_URL=redis://localhost:6379/0

# Aplicación
SECRET_KEY=change-me
ENVIRONMENT=development

# Cloudflare R2 (free tier) — para raw data
